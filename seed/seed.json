  "name": "Tavis",
  "description": "The Tavis marketing site",
  "author": "Cynco"
 },
 "settings": {
  "title": "Tavis",
  "tagline": "Free practice and online tuition for Form 1–5 students in Malaysia",
  "timezone": "Asia/Kuala_Lumpur"
 },
 "collections": [
  {
   "slug": "posts",
   "label": "Blog posts",
   "labelSingular": "Blog post",
   "description": "Articles at /blog. Publish a post and the site shows it within a few minutes.",
   "icon": "article",
   "supports": [
    "drafts",
    "revisions",
    "scheduling",
    "search",
    "seo"
   ],
   "urlPattern": "/blog/{slug}",
   "dateField": "publishedAt",
   "fields": [
    {
     "slug": "title",
     "label": "Title",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "excerpt",
     "label": "Summary, shown on the blog page and in Google",
     "type": "text",
     "searchable": true
    },
    {
     "slug": "cover",
     "label": "Cover picture, at the top of the post",
     "type": "image"
    },
    {
     "slug": "card_image",
     "label": "Blog page picture (optional, the cover is used when empty)",
     "type": "image"
    },
    {
     "slug": "body",
     "label": "Article",
     "type": "portableText",
     "required": true,
     "searchable": true
    }
   ],
   "sortOrder": 1
  },
  {
   "slug": "timetable",
