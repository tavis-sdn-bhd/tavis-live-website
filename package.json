{
  "name": "tavis-live-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/image-variants.mjs",
    "predev": "pnpm assets",
    "dev": "astro dev",
    "prebuild": "pnpm assets",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check",
    "cf-types": "wrangler types",
    "og": "node --import tsx scripts/og-cards.tsx",
    "assets": "pnpm images && pnpm og",
    "blog:inventory": "node scripts/blog/inventory.ts",
    "blog:import": "node scripts/blog/import.ts",
    "blog:verify": "node scripts/blog/verify.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/react": "7.1.9",
    "@emdash-cms/cloudflare": "1.5.0",
    "@emdash-cms/plugin-forms": "0.2.13",
    "@fontsource-variable/nunito": "5.3.0",
    "astro": "7.4.13",
    "emdash": "1.5.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261118.1",
    "@fontsource/nunito": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.165.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
