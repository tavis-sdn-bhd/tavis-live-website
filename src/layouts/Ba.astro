---
import "@fontsource-variable/nunito";
import "@/styles/globals.css";
import { StructuredData } from "@/components/structured-data";
import { links } from "@/lib/content";
import { ogAlt, ogImagePath, ogSize } from "@/og/cards";
import { type PagePath, pageMeta, siteName } from "@/lib/site";
import { BaChat, BaFooter, BaHeader } from "@/views/ba/chrome";

/** What a page with its own content (a blog post) says about itself, in place of its deck page's title and card. */
export type OwnMeta = {
  title: string;
  description: string;
  /** Its own share image; without one it shares its deck page's card. */
  image?: { url: string; width: number; height: number; alt: string };
  article?: { publishedTime: string };
};

/** A page of the site, or the 404, which shares the home page's card. A page under a deck page (a post under /blog)
    names that page as `path` and brings its own `meta`. */
type Props = ({ path: PagePath; notFound?: never } | { notFound: true; path?: never }) & { meta?: OwnMeta };

const page: PagePath = Astro.props.path ?? "/";
const own = Astro.props.meta;
const { title, description } = own ?? (Astro.props.notFound ? { title: "Page not found — Tavis", description: pageMeta("/").description } : pageMeta(page));
// From the request, so a preview on workers.dev links its own cards.
const ogImage = new URL(own?.image?.url ?? ogImagePath(page), Astro.url).href;
const ogImageMeta = own?.image ?? { ...ogSize, alt: ogAlt(page), type: "image/png" };
const appStoreId = "1580342756";
const androidPackage = "com.tavis.tavisapp.v26";
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:type" content={own?.article ? "article" : "website"} />
    {own?.article && <meta property="article:published_time" content={own.article.publishedTime} />}
    <meta property="og:image" content={ogImage} />
    {"type" in ogImageMeta && <meta property="og:image:type" content={ogImageMeta.type} />}
    <meta property="og:image:width" content={String(ogImageMeta.width)} />
    <meta property="og:image:height" content={String(ogImageMeta.height)} />
    <meta property="og:image:alt" content={ogImageMeta.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
    <meta property="al:ios:url" content={links.appStore} />
    <meta property="al:ios:app_store_id" content={appStoreId} />
    <meta property="al:ios:app_name" content={siteName} />
    <meta property="al:android:package" content={androidPackage} />
    <meta property="al:android:app_name" content={siteName} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <!-- Applies a saved "Pause animations" choice before first paint, so CSS loops never start. -->
    <script is:inline>try{if(localStorage.getItem("tavis:motion")==="paused")document.documentElement.dataset.motion="paused"}catch(e){}</script>
  </head>
  <body class="v2">
    <StructuredData />
    <a
      href="#main"
      class="fixed left-[max(1rem,env(safe-area-inset-left))] top-[max(1rem,env(safe-area-inset-top))] z-[100] -translate-y-[calc(100%+max(1rem,env(safe-area-inset-top))+1rem)] rounded-full bg-forest px-5 py-3 text-on-forest transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <BaHeader client:load path={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <BaFooter client:visible path={Astro.url.pathname} />
    <BaChat client:idle path={Astro.url.pathname} />
  </body>
</html>
