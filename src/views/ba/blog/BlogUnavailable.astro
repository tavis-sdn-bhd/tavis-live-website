---
import { cx } from "@/components/ui";
import { buttonClass, chunky } from "@/components/v2/ui";
import { indexHref } from "@/lib/blog";

/** A post that exists but could not be read just now: a 503, with a way to try again. */
---

<section id="top" data-band="white" class="shell py-[clamp(5rem,3rem+7vw,9rem)]">
  <div class={cx(chunky, "mx-auto max-w-[36rem] p-8 text-center sm:p-10")}>
    <h1 class="text-[1.75rem] leading-tight text-forest">This post didn’t load</h1>
    <p class="mt-3 font-semibold leading-relaxed text-muted">Something went wrong on our side. Try again in a moment, or go back to the other posts.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={Astro.url.pathname} class={buttonClass({ size: "md" })}>Try again</a>
      <a href={indexHref("ba", 1)} class={buttonClass({ tone: "white", size: "md" })}>All posts</a>
    </div>
  </div>
</section>
