---
import { Image, PortableText } from "emdash/ui";
import { cx } from "@/components/ui";
import { chunky } from "@/components/v2/ui";
import { type BlogPost, formatDate, indexHref, postHref, postSlug, readingMinutes } from "@/lib/blog";

/** A post: back to the index, its date and reading time, the title, the cover, the body at a reading measure, then the
    posts either side of it. Built with the site; the body is the post's Portable Text, set by `.article-body`. */
type Props = { post: BlogPost; newer: BlogPost | null; older: BlogPost | null };

const { post, newer, older } = Astro.props;
const { title, cover, body, publishedAt } = post.data;
const neighbours = [
  { post: newer, label: "Newer post", rel: "prev", arrow: "←" },
  { post: older, label: "Older post", rel: "next", arrow: "→" },
].filter((n): n is { post: BlogPost; label: string; rel: string; arrow: string } => n.post !== null);
---

<article>
  <header id="top" class="shell pt-[clamp(1.5rem,1rem+2.5vw,3.5rem)]">
    <div class="mx-auto max-w-[46rem]">
      <a href={indexHref("ba", 1)} class="link-press -ml-1 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-1 font-display text-caption uppercase tracking-[0.06em] text-sky-ink hover:text-sky-ledge">
        <span aria-hidden="true">←</span> All posts
      </a>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-caption font-extrabold uppercase tracking-[0.06em] text-muted sm:mt-6">
        {publishedAt && <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>}
        {publishedAt && <span aria-hidden="true">·</span>}
        <span>{readingMinutes(body)} min read</span>
      </p>
      <h1 class="mt-3 text-[clamp(1.875rem,1.2rem+2.9vw,3.25rem)] leading-[1.06] text-forest text-balance [overflow-wrap:break-word]">{title}</h1>
    </div>
  </header>

  {
    cover && (
      <div class="shell mt-8 sm:mt-10">
        <div class={cx(chunky, "mx-auto aspect-[3/2] max-w-[60rem] overflow-hidden bg-mint")}>
          <Image image={cover} alt="" priority sizes="(min-width: 64rem) 60rem, calc(100vw - 2 * clamp(1rem, 0.4rem + 2.6vw, 2.5rem))" class="size-full object-cover" />
        </div>
      </div>
    )
  }

  <div class="shell mt-10 sm:mt-14">
    <div class="article-body mx-auto max-w-[42rem]">
      <PortableText value={body} />
    </div>
  </div>

  <footer class="shell mt-14 pb-[clamp(4rem,2.5rem+6vw,7rem)] sm:mt-20">
    <div class="mx-auto max-w-[46rem] border-t-2 border-line pt-10">
      {
        neighbours.length > 0 && (
          <nav aria-label="More posts">
            <ul class="grid gap-4 sm:grid-cols-2">
              {neighbours.map((n) => (
                <li class={cx("flex", n.rel === "next" && neighbours.length === 1 && "sm:col-start-2")}>
                  <a
                    href={postHref("ba", postSlug(n.post))}
                    rel={n.rel}
                    class={cx(chunky, "press flex w-full flex-col gap-2 p-5 hover:border-sky/40 sm:p-6", n.rel === "next" && "sm:text-right")}
                  >
                    <span class="font-display text-caption uppercase tracking-[0.06em] text-sky-ink">
                      {n.rel === "prev" && <span aria-hidden="true">{n.arrow} </span>}
                      {n.label}
                      {n.rel === "next" && <span aria-hidden="true"> {n.arrow}</span>}
                    </span>
                    <span class="font-display text-[1.0625rem] leading-snug text-forest text-pretty">{n.post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <p class="mt-8 text-center">
        <a href={indexHref("ba", 1)} class="link-press inline-flex min-h-11 items-center font-display text-body-sm uppercase tracking-[0.05em] text-sky-ink hover:text-sky-ledge">See all posts</a>
      </p>
    </div>
  </footer>
</article>
