---
import { Image } from "emdash/ui";
import { cx } from "@/components/ui";
import { chunky } from "@/components/v2/ui";
import { type BlogPost, cardImage, formatDate, postHref, readingMinutes } from "@/lib/blog";

/** A post on the index: its picture, date and reading time, title and excerpt, the whole card one link. The featured
    card is the newest post, laid out wide from md. */
type Props = { post: BlogPost; featured?: boolean; priority?: boolean; headingLevel?: "h2" | "h3" };

const { post, featured = false, priority = false, headingLevel: Heading = "h2" } = Astro.props;
const image = cardImage(post);
const published = post.data.publishedAt;
---

<article class={cx(chunky, "group relative flex overflow-hidden transition-colors hover:border-sky/40", featured ? "flex-col md:grid md:grid-cols-[1.1fr_1fr]" : "flex-col")}>
  <div class={cx("relative aspect-[3/2] overflow-hidden bg-mint", featured && "md:aspect-auto md:h-full md:min-h-[22rem]")}>
    {
      image ? (
        <Image
          image={image}
          alt=""
          priority={priority}
          sizes={featured ? "(min-width: 78rem) 40rem, (min-width: 48rem) 52vw, 100vw" : "(min-width: 78rem) 24rem, (min-width: 64rem) 31vw, (min-width: 40rem) 46vw, 100vw"}
          class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.03] motion-reduce:transition-none"
        />
      ) : (
        <div aria-hidden="true" class="absolute inset-0 grid place-items-center text-brand-ink/40">
          <svg viewBox="0 0 24 24" class="size-12" fill="currentColor"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm3 2v2h10V7H7Zm0 4v2h10v-2H7Zm0 4v2h6v-2H7Z" /></svg>
        </div>
      )
    }
  </div>
  <div class={cx("flex flex-1 flex-col", featured ? "p-6 sm:p-8 md:p-10 md:justify-center" : "p-5 sm:p-6")}>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-caption font-extrabold uppercase tracking-[0.06em] text-muted">
      {featured && <span class="rounded-lg bg-sun px-2 py-1 text-forest shadow-[0_2px_0_var(--color-sun-ledge)]">Latest</span>}
      {published && <time datetime={published.toISOString()}>{formatDate(published)}</time>}
      {published && <span aria-hidden="true">·</span>}
      <span>{readingMinutes(post.data.body)} min read</span>
    </p>
    <Heading class={cx("mt-3 text-forest text-pretty [overflow-wrap:break-word]", featured ? "text-[clamp(1.5rem,1.05rem+1.8vw,2.25rem)] leading-[1.1]" : "text-[1.25rem] leading-[1.2] sm:text-[1.3125rem]")}>
      <a href={postHref("ba", post.data.slug ?? post.id)} class="link-press outline-none after:absolute after:inset-0 after:rounded-[inherit] after:content-[''] focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-forest group-hover:text-sky-ink">
        {post.data.title}
      </a>
    </Heading>
    {
      post.data.excerpt && (
        <p class={cx("mt-3 font-semibold leading-relaxed text-muted", featured ? "text-body-lg sm:text-[1.125rem] line-clamp-4" : "text-body-sm line-clamp-3")}>{post.data.excerpt}</p>
      )
    }
    {
      featured && (
        <span aria-hidden="true" class="ledge mt-7 inline-flex min-h-[3.125rem] w-fit items-center rounded-2xl bg-brand px-5 font-display text-body-sm uppercase tracking-[0.05em] text-forest shadow-[0_4px_0_var(--color-brand-ledge)]">
          Read the article
        </span>
      )
    }
  </div>
</article>
