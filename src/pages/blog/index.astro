---
import Layout from "@/layouts/Ba.astro";
import BlogIndex from "@/views/ba/blog/BlogIndex.astro";
import { indexPage, publishedPosts } from "@/lib/blog";

// Built with the site, from the posts published then (README, Blog). Page 2 and on are ./page/[page].astro.
export const prerender = true;

const page = indexPage(await publishedPosts(), 1);
---

<Layout path="/blog">
  <BlogIndex page={page} />
</Layout>
